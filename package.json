{
  "name": "billlens",
  "version": "2.16.0",
  "private": true,
  "description": "BillLens — offline-first, receipt-aware shared expense app",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:boundaries": "eslint .",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:validate": "node scripts/validate-sql.js",
    "secret-scan": "node scripts/secret-scan.js",
    "precommit": "npm run typecheck && npm run lint && npm run db:validate && npm run db:verify && npm run secret-scan && npm test -- --silent",
    "prepare": "husky || true",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:verify": "node scripts/verify-sqlite-schema.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.51.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.31",
    "expo-asset": "~57.0.20",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.52.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.4",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.3.2",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

# BillLens environment (example)
#
# Copy to `.env.local` — that file is git-ignored and must never be
# committed. Only EXPO_PUBLIC_* values reach the client bundle, so a
# Supabase SERVICE-ROLE key must never be placed here; the anon key is
# safe by design (row-level security enforces access).
#
# Everything is optional: BillLens is offline-first and boots without
# any cloud configuration (sync simply stays deferred).

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Supabase project (leave blank to run fully local)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# OCR provider: unset (default ML Kit on-device) | mlkit | mock | remote
# `mock` is sample data for JS-only development; never the implicit default.
# EXPO_PUBLIC_OCR_MODE=mlkit
